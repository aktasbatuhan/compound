{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compound.local/schemas/compound.config.v1.schema.json",
  "title": "Compound compound.yaml schema v1",
  "description": "The single source of truth for a Compound workspace: benchmark engine sections plus the product sections (task_keys, redaction, ingest). Generated from @compound/config zod schemas; do not edit by hand.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "artifacts_dir": {
      "type": "string",
      "minLength": 1
    },
    "manifests_dir": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "budget": {
      "type": "object",
      "properties": {
        "paid_runs_enabled": {
          "type": "boolean"
        },
        "hard_limit_usd": {
          "type": "number",
          "minimum": 0
        },
        "smoke_cases_per_benchmark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": {}
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "format": "uri"
          },
          "api_key_env": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "openai_compatible",
              "flex",
              "anthropic",
              "google"
            ]
          },
          "request_timeout_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "pricing_usd_per_million_tokens": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0
                },
                "output": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "base_url",
          "api_key_env"
        ],
        "additionalProperties": {}
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "frontier": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "backend": {
                "type": "string",
                "enum": [
                  "chat_completions",
                  "flex"
                ]
              },
              "provider_ids": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "provider"
            ],
            "additionalProperties": {}
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "backend": {
                "type": "string",
                "enum": [
                  "chat_completions",
                  "flex"
                ]
              },
              "provider_ids": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "provider"
            ],
            "additionalProperties": {}
          }
        }
      },
      "additionalProperties": {}
    },
    "pricing_usd_per_million_tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "input",
          "output"
        ],
        "additionalProperties": {}
      }
    },
    "flex_pricing_usd_per_million_tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "input",
          "output"
        ],
        "additionalProperties": {}
      }
    },
    "benchmarks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "task_key": {
            "type": "string",
            "minLength": 1
          },
          "sample_count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "partitions": {
            "type": "object",
            "properties": {
              "optimizer_train": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "optimizer_validation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "decision_test": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": {}
          },
          "revision": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "strata": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "task_key",
          "sample_count",
          "partitions"
        ],
        "additionalProperties": {}
      }
    },
    "optimization": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "mutable_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_metric_calls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "selection": {
          "type": "string"
        },
        "require_textual_feedback": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "gate": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "max_regression": {
          "type": "number"
        },
        "require_decision_test": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "task_keys": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "replay": {
            "type": "object",
            "properties": {
              "default_tool_policy": {
                "type": "string",
                "enum": [
                  "recorded",
                  "mocked",
                  "live_read_only",
                  "blocked"
                ]
              },
              "per_tool": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "recorded",
                    "mocked",
                    "live_read_only",
                    "blocked"
                  ]
                }
              }
            },
            "required": [
              "default_tool_policy"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "replay"
        ],
        "additionalProperties": false
      }
    },
    "redaction": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "applies_to": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "marker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detector": {
                    "type": "string",
                    "const": "secret"
                  }
                },
                "required": [
                  "name",
                  "applies_to",
                  "detector"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "applies_to": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "marker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detector": {
                    "type": "string",
                    "const": "pii"
                  }
                },
                "required": [
                  "name",
                  "applies_to",
                  "detector"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "applies_to": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "marker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detector": {
                    "type": "string",
                    "const": "regex"
                  },
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "applies_to",
                  "detector",
                  "pattern"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "field_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "rules"
      ],
      "additionalProperties": false
    },
    "ingest": {
      "type": "object",
      "properties": {
        "default_permissions": {
          "type": "object",
          "properties": {
            "judging": {
              "type": "boolean"
            },
            "optimization": {
              "type": "boolean"
            },
            "fine_tuning": {
              "type": "boolean"
            }
          },
          "required": [
            "judging",
            "optimization",
            "fine_tuning"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "importer": {
                "type": "string",
                "enum": [
                  "langfuse",
                  "json"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "importer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "default_permissions"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "valid_json",
                "json_schema",
                "contains",
                "not_contains",
                "regex",
                "equals",
                "tool_called",
                "tool_not_called",
                "tool_arg_equals",
                "tool_call_arg",
                "max_length",
                "json_path_equals",
                "text_similarity"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": {}
        }
      }
    },
    "judges": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1
          },
          "rubric": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "pointwise",
              "pairwise"
            ]
          },
          "calibration_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decision_point": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "model",
          "prompt_version",
          "rubric",
          "calibration_threshold"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "artifacts_dir",
    "manifests_dir",
    "benchmarks"
  ],
  "additionalProperties": {}
}
